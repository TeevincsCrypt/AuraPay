# ---------------------------------------------------------------------------
# AuraPay environment template. Copy to .env.local (dev) or set in Vercel.
# Every value is read server-side only; nothing is prefixed NEXT_PUBLIC_.
# Step-by-step guide: docs/ENV_SETUP.md
# AuraPay runs real integrations only — there are no demo or simulated modes.
# ---------------------------------------------------------------------------

# Public URL of the deployment. Used in sign-in messages and Nimiq Pay deep links.
APP_URL=https://your-domain.example

# ---- Database (required in production) --------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# On Vercel use the transaction pooler (port 6543); prepared statements are disabled automatically.
DATABASE_URL=
# Apply supabase/migrations/*.sql automatically on first connection (or use `supabase db push`).
DB_AUTO_MIGRATE=false
DATABASE_POOL_MAX=5
# Local development only (when DATABASE_URL is empty): embedded PGlite directory, or "memory".
PGLITE_DIR=

# ---- Utilities provider (airtime, data, electricity) -------------------------
# Flutterwave Bills (recommended). Dashboard → Settings → API Keys → Secret key.
# A FLWSECK_TEST-… key runs in test mode: orders are labelled TEST and nothing is delivered.
FLUTTERWAVE_SECRET_KEY=

# Reloadly (alternative). production (default) or sandbox.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_MODE=production

# Optional: force "flutterwave" or "reloadly" when both are configured.
UTILITY_PROVIDER=

# ---- Nimiq (NIM payments) ---------------------------------------------------
NIMIQ_NETWORK=mainnet
# Merchant address that receives NIM (you hold its keys in your own wallet).
NIMIQ_MERCHANT_ADDRESS=
# Nimiq Albatross JSON-RPC used to VERIFY payments. Mainnet defaults to rpc.nimiqwatch.com
# (an open server for testing); for production run your own node or use a provider.
NIMIQ_RPC_URL=
NIMIQ_RPC_AUTH=
NIMIQ_MIN_CONFIRMATIONS=2

# ---- USDT on Polygon ---------------------------------------------------------
POLYGON_MERCHANT_ADDRESS=
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_MIN_CONFIRMATIONS=10
# Allow real-value payments to fund test-mode (sandbox) top-ups. Leave false.
ALLOW_REAL_PAYMENTS_FOR_SANDBOX=false

# ---- EVM RPCs (tokenised-stock balances, Aave V4 on Base, receipts) ---------
BASE_RPC_URL=https://base-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# ---- Pricing ----------------------------------------------------------------
AURAPAY_SERVICE_FEE_BPS=150
AURAPAY_MIN_SERVICE_FEE_USD=0.10
QUOTE_TTL_SECONDS=600
NIM_SLIPPAGE_BPS=100

# ---- Prices (CoinGecko) — NIM/USDT rates, tokenised-stock prices and charts ----
COINGECKO_API_KEY=
COINGECKO_PRO=false

# ---- Optional listed-share market data ---------------------------------------
# Without these, quotes and charts use the live tokenised-stock market (CoinGecko).
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# ---- Investing via CoW Protocol ---------------------------------------------
COW_APP_CODE=AuraPay
# Optional CoW partner fee on stock purchases (revenue). Both must be set.
COW_PARTNER_FEE_BPS=0
COW_PARTNER_FEE_RECIPIENT=

# ---- Operations -------------------------------------------------------------
ADMIN_API_TOKEN=
RATE_LIMIT_MULTIPLIER=1

# ---- TEST ONLY: local mock providers (scripts/mock-providers.mjs) -----------
# Honoured only when AURAPAY_TEST_MODE=true (refused on Vercel production deployments).
# AURAPAY_TEST_MODE=true
# FLUTTERWAVE_URL_OVERRIDE=http://localhost:4010/flw
# RELOADLY_AUTH_URL_OVERRIDE=http://localhost:4010/auth/oauth/token
# RELOADLY_AIRTIME_URL_OVERRIDE=http://localhost:4010/airtime
# RELOADLY_UTILITIES_URL_OVERRIDE=http://localhost:4010/utilities
# COINGECKO_URL_OVERRIDE=http://localhost:4010/coingecko
# EVM_RPC_URL_OVERRIDE=http://localhost:4010/evm
# COW_API_URL_OVERRIDE=http://localhost:4010/cow
