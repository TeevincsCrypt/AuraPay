# ---------------------------------------------------------------------------
# AuraPay environment template. Copy to .env.local (dev) or set in Vercel.
# Every secret here is read server-side only. Nothing is prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# development | demo | sandbox | production
#   development/demo: simulators allowed (simulated payments, paper investing, lending simulator), PGlite fallback allowed
#   sandbox:          real wallet payments (testnet NIM) + Reloadly sandbox; no simulators; DATABASE_URL required
#   production:       real payments + Reloadly production; no simulators; test overrides ignored
APP_MODE=development

# >= 32 random chars; signs the anonymous session cookie. Required in sandbox/production.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ---- Database --------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string (URI).
# On Vercel use the transaction pooler (port 6543); prepared statements are disabled automatically.
DATABASE_URL=
# Run supabase/migrations/*.sql automatically on first connection (otherwise use `supabase db push`).
DB_AUTO_MIGRATE=false
DATABASE_POOL_MAX=5
# Without DATABASE_URL (development/demo only) AuraPay uses embedded PGlite.
# Directory for persistent PGlite data, or "memory" for in-memory. Defaults to .data/pglite (in-memory on Vercel).
PGLITE_DIR=

# ---- Reloadly (airtime, data, electricity) ---------------------------------
# https://www.reloadly.com → Developers → API settings. Use the sandbox credentials first.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_MODE=sandbox

# ---- Nimiq (NIM payments) --------------------------------------------------
# mainnet | testnet. Sandbox top-ups can only be paid with testnet NIM.
NIMIQ_NETWORK=testnet
# The AuraPay merchant address that receives NIM (you hold its keys in your own wallet).
NIMIQ_MERCHANT_ADDRESS=
# JSON-RPC endpoint of a Nimiq Albatross node, used to VERIFY payments server-side.
# Mainnet defaults to the documented open server https://rpc.nimiqwatch.com (testing only);
# testnet has no default — run your own node or pick one from nimiq.dev/rpc/open-servers.
NIMIQ_RPC_URL=
# Optional basic auth for a private node: user:password
NIMIQ_RPC_AUTH=
NIMIQ_MIN_CONFIRMATIONS=2

# ---- USDT on Polygon -------------------------------------------------------
# Merchant EVM address that receives USDT (Polygon PoS).
POLYGON_MERCHANT_ADDRESS=
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_MIN_CONFIRMATIONS=10
# Allow real-value payments (mainnet NIM / Polygon USDT) to fund SANDBOX top-ups. Leave false.
ALLOW_REAL_PAYMENTS_FOR_SANDBOX=false

# ---- Pricing ---------------------------------------------------------------
AURAPAY_SERVICE_FEE_BPS=150
AURAPAY_MIN_SERVICE_FEE_USD=0.10
QUOTE_TTL_SECONDS=600
NIM_SLIPPAGE_BPS=100

# ---- Exchange rates (CoinGecko) --------------------------------------------
# Optional. Works without a key at low volume; a free "demo" key raises limits.
COINGECKO_API_KEY=
COINGECKO_PRO=false

# ---- Market data -----------------------------------------------------------
# Quotes, logos, market status: https://finnhub.io (free tier)
FINNHUB_API_KEY=
# Price history: https://twelvedata.com (free tier)
TWELVEDATA_API_KEY=

# ---- Execution & lending providers (not integrated yet; see docs/INTEGRATIONS.md)
BROKERAGE_PROVIDER=
LENDING_PROVIDER=
SIM_LOAN_APR=0.12
SIM_MAX_LTV=0.40
SIM_LIQUIDATION_LTV=0.60

# ---- Operations ------------------------------------------------------------
# Bearer token for /api/admin/* (reconciliation & verified refunds). Leave empty to disable.
ADMIN_API_TOKEN=
# Scale all per-client rate limits (e.g. 10 for load tests).
RATE_LIMIT_MULTIPLIER=1

# ---- TEST ONLY (ignored when APP_MODE=production) ---------------------------
# Point providers at scripts/mock-providers.mjs for offline end-to-end tests.
# RELOADLY_AUTH_URL_OVERRIDE=http://localhost:4010/auth/oauth/token
# RELOADLY_AIRTIME_URL_OVERRIDE=http://localhost:4010/airtime
# RELOADLY_UTILITIES_URL_OVERRIDE=http://localhost:4010/utilities
# COINGECKO_URL_OVERRIDE=http://localhost:4010/coingecko
